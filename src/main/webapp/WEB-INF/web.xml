<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>SMART CARZONE</display-name>

  <!-- Optional: Google Custom Search (Image) — https://developers.google.com/custom-search/v1/overview -->
  <context-param>
    <param-name>google.cse.key</param-name>
    <param-value></param-value>
  </context-param>
  <context-param>
    <param-name>google.cse.cx</param-name>
    <param-value></param-value>
  </context-param>
  <!-- Optional: IMAGIN.studio car renders — https://www.imagin.studio/car-image-api -->
  <context-param>
    <param-name>imagin.studio.customer</param-name>
    <param-value></param-value>
  </context-param>

  <!-- Session timeout of 30 minutes -->
  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <!-- Welcome files -->
  <welcome-file-list>
    <welcome-file>front.jsp</welcome-file>
  </welcome-file-list>

</web-app>


